# Copy this file to .env and fill in the values.
# To generate SECRET_KEY:
# python3 -c "import secrets; print(secrets.token_urlsafe())"

SECRET_KEY=

# Leave MODE empty for local development.
# Set MODE=production when running with gunicorn / docker production path.
MODE=

# Use these defaults for native mode.
# For docker compose mode, set DB_HOST=postgres.
DB_HOST=127.0.0.1
DB_NAME=dev_db
DB_USER=admin
DB_PASSWORD=root
DB_PORT=5432

# Recommended host list when binding to 0.0.0.0.
ALLOWED_HOSTS=0.0.0.0 127.0.0.1 localhost

# Optional: absolute or relative path for serving JBrowse at /dendrobium/syntney/.
# If empty, Django falls back to ../JBrowse2_MultiWay (relative to this repo).
JBROWSE_DIR=

# Set the following variables to the values of your Cloudinary account.
CDN_NAME=
CDN_API_KEY=
CDN_API_SECRET=

# Set the following variables to the values of your SMTP server.
SMTP_HOST_USER=
SMTP_HOST_PASSWORD=

# Set TEST=1 to run tests with sqlite.
TEST=
